Options -Indexes

# Unknown addresses show the Chef 404 page.
ErrorDocument 404 /404.html

# The public package includes database/lib.php for the admin runtime. Never serve it.
<IfModule mod_alias.c>
    RedirectMatch 404 "(?i)(?:^|/)database/"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(?:html|css|js|svg|png|jpe?g|webp|ico)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </FilesMatch>

    # Guest CSP. The hashes cover the single inline <script> and <style> in index.html.
    # Run "npm test" after each guest change. database/tests/security-headers-static.mjs checks these hashes.
    # PHP admin responses send their own policy from admin/security.php.
    <Files "index.html">
        Header always set Content-Security-Policy "default-src 'none'; script-src 'sha256-AL9IZqbbsbL7u6IpFxWWjJs7/gB0iNI/9/GYNp62PN0='; style-src 'sha256-3neHChANks7YHcmo4ftcVHD164LMguTxlgttxz/lqVc='; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        Header always set X-Frame-Options "DENY"
        Header always set Cross-Origin-Opener-Policy "same-origin"
        # Browsers revalidate the page on each visit. An unchanged page costs only a 304 reply.
        Header always set Cache-Control "no-cache"
    </Files>

    # 404 page: one inline style, no script.
    <Files "404.html">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'sha256-VI1PFkp+Kt0si3JcdnGfrhSWaIdFQl+wlpsN0z+GOSw='; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        Header always set X-Frame-Options "DENY"
        Header always set Cache-Control "no-cache"
    </Files>
</IfModule>
